rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /registros/{documentId} {
      function signedIn() {
        return request.auth != null;
      }
      function isOwner() {
        return signedIn() && resource.data.ownerUid == request.auth.uid;
      }
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['nome', 'descricao', 'criadoEm', 'ownerUid'])
        && request.resource.data.keys().hasAll(['nome', 'descricao', 'criadoEm', 'ownerUid'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.nome.size() <= 120
        && request.resource.data.descricao is string
        && request.resource.data.descricao.size() > 0
        && request.resource.data.descricao.size() <= 2000
        && request.resource.data.criadoEm is timestamp;
      allow read, delete: if isOwner();
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'descricao'])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.nome.size() <= 120
        && request.resource.data.descricao is string
        && request.resource.data.descricao.size() > 0
        && request.resource.data.descricao.size() <= 2000;
    }
  }
}
